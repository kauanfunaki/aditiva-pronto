{
  "compilerOptions": {
    "target":         "ES2022",
    "module":         "commonjs",
    "lib":            ["ES2022"],
    "outDir":         "./dist",
    "rootDir":        "./src",
    "strict":         true,
    "esModuleInterop": true,
    "skipLibCheck":   true,
    "resolveJsonModule": true,
    "declaration":    true,
    "declarationMap": true,
    "sourceMap":      true,
    "paths": {
      "@shared/*": ["../../shared/*"]
    }
  },
  "include": ["src/**/*", "../../shared/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
