# URL do app terminando em /api. Não inclua barra no final.
AUDIT_API_BASE_URL=https://aditivapronto.41tech.cloud/api

# Gere um token novo para a instalação. Nunca versione o .env real.
AUDIT_ROBOT_TOKEN=

# O hostname do Windows é usado quando esta variável fica vazia.
AUDIT_ROBOT_HOST=

# Intervalos em milissegundos.
AUDIT_POLL_INTERVAL_MS=15000
AUDIT_REQUEST_TIMEOUT_MS=30000
AUDIT_RETRY_ATTEMPTS=3

# Use apenas para diagnosticar a instalação. Não altera a rede.
AUDIT_LOG_LEVEL=info
